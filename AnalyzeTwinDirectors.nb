Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"   n1(x,y) = \"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", 
         FractionBox["x", "2"], "]"}], " ", 
        RowBox[{"Cosh", "[", 
         FractionBox["y", "2"], "]"}], " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          FractionBox["8", 
           RowBox[{
            RowBox[{"Cos", "[", "x", "]"}], "+", 
            RowBox[{"Cosh", "[", "y", "]"}]}]]}]]}], "-", 
       RowBox[{
        RowBox[{"Sin", "[", 
         FractionBox["x", "2"], "]"}], " ", 
        RowBox[{"Sinh", "[", 
         FractionBox["y", "2"], "]"}]}]}], ")"}]}], "+", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Cos", "[", 
          FractionBox["x", "2"], "]"}]}], " ", 
        RowBox[{"Cosh", "[", 
         FractionBox["y", "2"], "]"}]}], "-", 
       RowBox[{
        SqrtBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          FractionBox["8", 
           RowBox[{
            RowBox[{"Cos", "[", "x", "]"}], "+", 
            RowBox[{"Cosh", "[", "y", "]"}]}]]}]], " ", 
        RowBox[{"Sin", "[", 
         FractionBox["x", "2"], "]"}], " ", 
        RowBox[{"Sinh", "[", 
         FractionBox["y", "2"], "]"}]}]}], ")"}]}]}]}],
  SequenceForm["   n1(x,y) = ", Complex[0, 
      Rational[1, 2]] (
     Cos[Rational[1, 2] $CellContext`x] 
      Cosh[Rational[1, 2] $CellContext`y] (-1 + 
        8/(Cos[$CellContext`x] + Cosh[$CellContext`y]))^Rational[1, 2] - 
     Sin[Rational[1, 2] $CellContext`x] Sinh[Rational[1, 2] $CellContext`y]) + 
   Rational[1, 2] (-Cos[Rational[1, 2] $CellContext`x] 
      Cosh[Rational[1, 2] $CellContext`y] - (-1 + 
       8/(Cos[$CellContext`x] + Cosh[$CellContext`y]))^Rational[1, 2] 
     Sin[Rational[1, 2] $CellContext`x] Sinh[Rational[1, 2] $CellContext`y])],
  Editable->False]], "Print",
 CellChangeTimes->{4.0015800029351826`*^9, 4.0015806149179096`*^9, 

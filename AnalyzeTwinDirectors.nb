        RowBox[{"Cos", "[", 
         FractionBox["x", "2"], "]"}], " ", 
        RowBox[{"Cosh", "[", 
         FractionBox["y", "2"], "]"}]}], "-", 
       RowBox[{
        SqrtBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          FractionBox["8", 

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"   w1 = 2*d_z(n1) = \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{"4", " ", "\[ImaginaryI]", " ", 
     SuperscriptBox[
      RowBox[{"Cos", "[", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], "]"}], "2"], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"x", "+", 
         RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], "]"}]}], 
    RowBox[{
     SqrtBox[
      RowBox[{"8", "-", 
       RowBox[{"Cos", "[", "x", "]"}], "-", 
       RowBox[{"Cosh", "[", "y", "]"}]}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cos", "[", "x", "]"}], "+", 
        RowBox[{"Cosh", "[", "y", "]"}]}], ")"}], 
      RowBox[{"3", "/", "2"}]]}]]}],
  SequenceForm[
  "   w1 = 2*d_z(n1) = ", Complex[0, 4] 
   Cos[Rational[1, 2] ($CellContext`x + Complex[0, -1] $CellContext`y)]^2 (8 - 
     Cos[$CellContext`x] - Cosh[$CellContext`y])^
    Rational[-1, 2] (Cos[$CellContext`x] + Cosh[$CellContext`y])^
    Rational[-3, 2] 
   Sin[Rational[1, 2] ($CellContext`x + Complex[0, 1] $CellContext`y)]],

         FractionBox["x", "2"], "]"}], " ", 
        RowBox[{"Sinh", "[", 
         FractionBox["y", "2"], "]"}]}]}], ")"}]}]}]}],
  SequenceForm["   n2(x,y) = ", Complex[0, 
      Rational[1, 2]] (
     Cos[Rational[1, 2] $CellContext`x] 
      Cosh[Rational[1, 2] $CellContext`y] (-1 + 
        8/(Cos[$CellContext`x] + Cosh[$CellContext`y]))^Rational[1, 2] + 

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Calculated Laplacian (\[CapitalDelta]\[Theta]) = \"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "-", 
         FractionBox["x", "10"]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox["x", "10"]}], ")"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"800", " ", 
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", 
            FractionBox["x", "10"]}], ")"}], "2"], "+", 
         FractionBox[
          SuperscriptBox["y", "2"], "100"]}]], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           FractionBox["1", "4"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 FractionBox["x", "10"]}], ")"}], "2"]}], "-", 
             FractionBox[
              SuperscriptBox["y", "2"], "100"]}], ")"}]}]}], ")"}], 

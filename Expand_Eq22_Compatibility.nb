      RowBox[{"wbarSym", "->", "wbarTest"}], ",", 
      RowBox[{"DzW", "->", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"twoDz", "[", "wTest", "]"}], "]"}]}], ",", 
      RowBox[{"DzbarW", "->", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"twoDzbar", "[", "wTest", "]"}], "]"}]}], ",", 
      RowBox[{"DzWbar", "->", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"twoDz", "[", "wbarTest", "]"}], "]"}]}], ",", 
      RowBox[{"DzbarWbar", "->", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"twoDzbar", "[", "wbarTest", "]"}], "]"}]}], ",", 
      RowBox[{"LaplacianW", "->", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"twoDz", "[", 
         RowBox[{"twoDzbar", "[", "wTest", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"DzzWbar", "->", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"twoDz", "[", 
         RowBox[{"twoDz", "[", "wbarTest", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"RSymbol", "->", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"ComplexExpand", "[", 
          RowBox[{
           RowBox[{"twoDzbar", "[", "wTest", "]"}], "*", 
           RowBox[{"twoDz", "[", "wbarTest", "]"}]}], "]"}], "-", 
         RowBox[{
          RowBox[{"wTest", "^", "2"}], "*", 
          RowBox[{"wbarTest", "^", "2"}]}]}], "]"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"residualEq22", "=", 
